# ---------------------------------------------------------------------------
# n8n-mounted DSH runtime home (dsh-data). Track preset/profile source only.
# Container still mounts this tree at /data/dsh.
# ---------------------------------------------------------------------------
dsh-data/.pnpm-store/

# Per-instance runtime / secrets
dsh-data/**/.anonymous-user-id
dsh-data/**/.credentials.yaml
dsh-data/**/.env

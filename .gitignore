dsh-data/**/settings.yaml.imported
dsh-data/**/node_modules/
dsh-data/**/dist/
dsh-data/**/.cache/
dsh-data/**/*.log
dsh-data/**/*.jsonl
dsh-data/**/*.mp4
dsh-data/**/*.key
dsh-data/**/*.pem
dsh-data/**/.DS_Store
dsh-data/**/.git.bak-pre-unify-*/
dsh-data/**/.s2s-control-status.json
dsh-data/**/*.bak
dsh-data/**/*.bak-*

# Business runtime artifacts (camera, media, feedback, caches, archives)
dsh-data/**/runtime_data/
dsh-data/**/skill2workflow/
# DeepSeek Files upload index under DSH home
dsh-data/**/llm-deepseek/

# Workspace local agent state and leftover process files

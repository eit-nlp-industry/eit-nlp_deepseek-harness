# Copy to .env and fill in.
# Harness (cordis !!js process.env.*): n8n injects this file into the child env at
# spawn (patches-user/deepseek-harness-cli.service.js). Change values then
# Restart Harness / reopen Studio.
# Local scripts (post-robot-task-result.sh / task-result-ui): source this file on each run.
RAGFLOW_API_KEY=
RAG_MCP_TOKEN=
WEKNORA_MCP_TOKEN=
ROBOT_MCP_TOKEN=
ROBOT_CALLBACK_TOKEN=
# Optional override for scripts; default is http://10.37.0.21:13181/robot-task-results
# ROBOT_CALLBACK_URL=
LLM_API_KEY=
SKILL_EVOLVER_API_KEY=

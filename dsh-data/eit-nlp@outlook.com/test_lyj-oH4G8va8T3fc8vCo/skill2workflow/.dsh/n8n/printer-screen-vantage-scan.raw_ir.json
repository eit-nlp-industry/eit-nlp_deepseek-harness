{
  "name": "printer-screen-vantage-scan",
  "skill_id": "printer-screen-vantage-scan",
  "notes": [
    "Catalog search returned no results; node types chosen from the standard n8n core set referenced by the skill's tool calls (dog_move / dog_wait_arrived / dog_capture).",
    "Each vantage is a move → wait → capture sequence; the If after each capture checks readable and routes to the next vantage on false.",
    "Vantage order and failure reasons come from skill lines 25-29; the trajectory confirms front (too small) → closer (glare) → oblique (readable).",
    "dog_* tool endpoints are not specified in the skill, so HTTP nodes carry needs_user_input for url/credential."
  ],
  "nodes": [
    {
      "id": "n1",
      "name": "Start Case",
      "n8n_type": "n8n-nodes-base.manualTrigger",
      "slots": {},
      "tool": null,
      "source": {
        "kind": "skill_line",
        "locator": "13",
        "quote": "For each candidate vantage in order, run exactly this sequence:"
      }
    },
    {
      "id": "n2",
      "name": "Move to print-area-front",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "",
        "json_body": {
          "body": "dog-01",
          "target": "print-area-front",
          "goal": "reach the printer in the print area"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_move",
      "source": {
        "kind": "skill_line",
        "locator": "16",
        "quote": "dog_move({\"body\": \"dog-01\", \"target\": \"<vantage>\", \"goal\": \"<why this vantage>\"})"
      }
    },
    {
      "id": "n3",
      "name": "Wait arrived at front",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "",
        "json_body": {
          "job_id": "={{ $json.job_id }}"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_wait_arrived",
      "source": {
        "kind": "skill_line",
        "locator": "17",
        "quote": "dog_wait_arrived({\"job_id\": \"<job_id from dog_move>\"})"
      }
    },
    {
      "id": "n4",
      "name": "Capture printer-screen at front",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "",
        "json_body": {
          "target": "printer-screen",
          "pose": "print-area-front"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_capture",
      "source": {
        "kind": "skill_line",
        "locator": "18",
        "quote": "dog_capture({\"target\": \"printer-screen\", \"pose\": \"<vantage>\"})"
      }
    },
    {
      "id": "n5",
      "name": "Front readable?",
      "n8n_type": "n8n-nodes-base.if",
      "slots": {
        "left": "={{ $json.readable }}",
        "op": "equal",
        "right": "true",
        "type": "boolean"
      },
      "tool": null,
      "source": {
        "kind": "skill_line",
        "locator": "25",
        "quote": "`print-area-front` — baseline. If `readable: false` with reason `screen text too small`, move closer."
      }
    },
    {
      "id": "n6",
      "name": "Move to print-area-front-closer",

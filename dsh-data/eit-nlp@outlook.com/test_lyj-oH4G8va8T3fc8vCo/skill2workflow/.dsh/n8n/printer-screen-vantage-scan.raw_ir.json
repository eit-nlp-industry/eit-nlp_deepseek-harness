          "goal": "get closer so the screen text is larger"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_move",
      "source": {
        "kind": "skill_line",
        "locator": "26",
        "quote": "`print-area-front-closer` — fixes small text."
      }
    },

{
  "name": "dog-screen-inspection-loop",
  "skill_id": "dog-screen-inspection-loop",
  "notes": [
    "Vantage escalation ladder front -> front-closer -> oblique-front, each rung a move/wait/capture triple.",
    "Each readable check is an exclusive If; true arm reports DONE, false arm continues to the next rung.",
    "Final rung false arm reports FAILED (ladder exhausted).",
    "dog_* tool calls are HTTP requests to a robot-dog bridge; URL/credential needs user input."
  ],
  "nodes": [
    {
      "id": "n1",
      "name": "Start Inspection",
      "n8n_type": "n8n-nodes-base.manualTrigger",
      "slots": {},
      "tool": null,
      "source": {
        "kind": "skill_line",
        "locator": "9",
        "quote": "Inspect a physical screen/panel with the robot dog and report a condition (e.g. paper out) backed by an actual readable capture."
      }
    },
    {
      "id": "n2",
      "name": "Move To Front Vantage",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "={{ $env.DOG_BRIDGE_URL }}/dog_move",
        "json_body": {
          "body": "={{ $json.body }}",
          "target": "={{ $json.area_id }}-front",
          "goal": "reach the printer in the print area"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_move",
      "source": {
        "kind": "skill_line",
        "locator": "14",
        "quote": "dog_move({body, target: <vantage>, goal: <why>})  -> job_id"
      }
    },
    {
      "id": "n3",
      "name": "Wait Arrived Front",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "={{ $env.DOG_BRIDGE_URL }}/dog_wait_arrived",
        "json_body": {
          "job_id": "={{ $json.job_id }}"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_wait_arrived",
      "source": {
        "kind": "skill_line",
        "locator": "15",
        "quote": "dog_wait_arrived({job_id})                         -> must return arrived"
      }
    },
    {
      "id": "n4",
      "name": "Capture Front",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "={{ $env.DOG_BRIDGE_URL }}/dog_capture",
        "json_body": {
          "target": "={{ $json.target }}",
          "pose": "={{ $json.area_id }}-front"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_capture",
      "source": {
        "kind": "skill_line",
        "locator": "16",
        "quote": "dog_capture({target: <screen>, pose: <vantage>})   -> {readable, reason?, screen_text?}"
      }
    },
    {
      "id": "n5",
      "name": "Front Readable?",
      "n8n_type": "n8n-nodes-base.if",
      "slots": {
        "left": "={{ $json.readable }}",
        "op": "eq",
        "right": true,
        "type": "boolean"
      },
      "tool": null,
      "source": {
        "kind": "skill_line",
        "locator": "35",
        "quote": "A condition may only be reported if a `dog_capture` call in this session returned `readable=true` with the `screen_text` that supports it."
      }
    },
    {
      "id": "n6",
      "name": "Report DONE",
      "n8n_type": "n8n-nodes-base.set",
      "slots": {
        "include_other_fields": true,
        "assignments": {
          "report": "=DONE case={{ $json.case_id }} paper_out={{ $json.paper_out }} vantage={{ $json.pose }}",
          "screen_text": "={{ $json.screen_text }}",
          "vantage": "={{ $json.pose }}"
        }
      },
      "tool": null,
      "source": {
        "kind": "skill_line",
        "locator": "44",
        "quote": "DONE case=<case_id> paper_out=<true|false> vantage=<vantage_that_produced_readable_true>"
      }
    },
    {
      "id": "n7",
      "name": "Move To Front-Closer",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "={{ $env.DOG_BRIDGE_URL }}/dog_move",
        "json_body": {
          "body": "={{ $json.body }}",
          "target": "={{ $json.area_id }}-front-closer",
          "goal": "get closer so the screen text is larger"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_move",
      "source": {
        "kind": "skill_line",
        "locator": "27",
        "quote": "| text too small / illegible size | `<area>-front-closer` | \"get closer so the screen text is larger\" |"
      }
    },
    {
      "id": "n8",
      "name": "Wait Arrived Front-Closer",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "={{ $env.DOG_BRIDGE_URL }}/dog_wait_arrived",
        "json_body": {
          "job_id": "={{ $json.job_id }}"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_wait_arrived",
      "source": {
        "kind": "skill_line",
        "locator": "19",
        "quote": "Never call `dog_capture` before `dog_wait_arrived` confirms arrival for that move."
      }
    },
    {
      "id": "n9",
      "name": "Capture Front-Closer",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "={{ $env.DOG_BRIDGE_URL }}/dog_capture",
        "json_body": {
          "target": "={{ $json.target }}",
          "pose": "={{ $json.area_id }}-front-closer"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_capture",
      "source": {
        "kind": "skill_line",
        "locator": "31",
        "quote": "Do not skip rungs: front → front-closer → oblique-front. Each rung must have its own move/wait/capture triple in the log."
      }
    },
    {
      "id": "n10",
      "name": "Front-Closer Readable?",
      "n8n_type": "n8n-nodes-base.if",
      "slots": {
        "left": "={{ $json.readable }}",
        "op": "eq",
        "right": true,
        "type": "boolean"
      },
      "tool": null,
      "source": {
        "kind": "skill_line",
        "locator": "36",
        "quote": "If the last logged capture is `readable=false`, you have NOT finished — either run the next rung or report failure."
      }
    },
    {
      "id": "n11",
      "name": "Move To Oblique-Front",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "={{ $env.DOG_BRIDGE_URL }}/dog_move",
        "json_body": {
          "body": "={{ $json.body }}",
          "target": "={{ $json.area_id }}-oblique-front",
          "goal": "side-front vantage that can still see the screen"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_move",
      "source": {
        "kind": "skill_line",
        "locator": "28",
        "quote": "| glare / reflection on screen | `<area>-oblique-front` | \"side-front vantage that can still see the screen\" |"
      }
    },
    {
      "id": "n12",
      "name": "Wait Arrived Oblique-Front",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "={{ $env.DOG_BRIDGE_URL }}/dog_wait_arrived",
        "json_body": {
          "job_id": "={{ $json.job_id }}"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_wait_arrived",
      "source": {
        "kind": "trajectory_event",
        "locator": "e15",
        "quote": "dog_wait_arrived"
      }
    },
    {
      "id": "n13",
      "name": "Capture Oblique-Front",
      "n8n_type": "n8n-nodes-base.httpRequest",
      "slots": {
        "method": "POST",
        "url": "={{ $env.DOG_BRIDGE_URL }}/dog_capture",
        "json_body": {
          "target": "={{ $json.target }}",
          "pose": "={{ $json.area_id }}-oblique-front"
        },
        "needs_user_input": [
          "url",
          "credential_name"
        ]
      },
      "tool": "dog_capture",
      "source": {
        "kind": "trajectory_event",
        "locator": "e17",
        "quote": "dog_capture"
      }
    },
    {
      "id": "n14",
      "name": "Oblique-Front Readable?",
      "n8n_type": "n8n-nodes-base.if",
      "slots": {
        "left": "={{ $json.readable }}",
        "op": "eq",
        "right": true,
        "type": "boolean"
      },
      "tool": null,
      "source": {
        "kind": "trajectory_event",
        "locator": "e18",
        "quote": "readable"
      }
    },
    {
      "id": "n15",
      "name": "Report FAILED",
      "n8n_type": "n8n-nodes-base.set",
      "slots": {
        "include_other_fields": true,
        "assignments": {
          "report": "=FAILED case={{ $json.case_id }} reason={{ $json.reason }} vantages_tried={{ $json.area_id }}-front,{{ $json.area_id }}-front-closer,{{ $json.area_id }}-oblique-front"
        }
      },
      "tool": null,
      "source": {
        "kind": "skill_line",
        "locator": "50",
        "quote": "FAILED case=<case_id> reason=<last readable=false reason> vantages_tried=<comma-separated>"
      }
    }
  ],

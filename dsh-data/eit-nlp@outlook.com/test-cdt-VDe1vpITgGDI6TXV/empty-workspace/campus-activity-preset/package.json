{
  "name": "@local/dsh-campus-activity-preset",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "用 JSON Render 卡片分步筹备校园活动：步骤数按复杂度自适应（3–5 步），需要时用 Workflow 组件编排执行流程；不预约场地、不采购、不发通知。",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "exports": {
    ".": "./index.js",
    "./plan-store": "./index.js",
    "./package.json": "./package.json",
    "./observation-tools.js": "./observation-tools.js",
    "./annotate-media.js": "./annotate-media.js",
    "./booking-mock.js": "./booking-mock.js",
    "./location-mock.js": "./location-mock.js",
    "./person-media.js": "./person-media.js",
    "./inspection-task.js": "./inspection-task.js",
    "./inspection-schema.js": "./inspection-schema.js",
    "./inspection-store.js": "./inspection-store.js",
    "./robot-job-result.js": "./robot-job-result.js",
    "./callback-server.js": "./callback-server.js",
    "./job-bridge.js": "./job-bridge.js",
    "./ragflow-semantic-map.js": "./ragflow-semantic-map.js"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "runtime",
    "observation-tools.js",
    "annotate-media.js",
    "booking-mock.js",
    "location-mock.js",
    "person-media.js",
    "inspection-task.js",
    "inspection-schema.js",
    "inspection-store.js",
    "inspection-schema.test.js",
    "robot-job-result.js",
    "callback-server.js",
    "job-bridge.js",
    "ragflow-semantic-map.js",
    "campus-open-day.json"
  ]
}

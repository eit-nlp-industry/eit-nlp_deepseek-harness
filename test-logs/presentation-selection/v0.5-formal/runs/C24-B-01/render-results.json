notify_absent\", \"type\": \"action\", \"label\": \"通知我：老师不在\", \"config\": {\"channel\": \"通知\", \"target\": \"我\", \"message\": \"林老师不在，已停止等待\"}, \"next\": \"end_absent\"}, {\"id\": \"end_absent\", \"type\": \"end\", \"label\": \"结束（老师不在）\"}, {\"id\": \"photo_confirm\", \"type\": \"action\", \"label\": \"拍照确认材料\", \"next\": \"send_back\"}, {\"id\": \"send_back\", \"type\": \"action\", \"label\": \"把材料送回\", \"next\": \"end_done\"}, {\"id\": \"end_done\", \"type\": \"end\", \"label\": \"结束（已送回）\"}], \"edges\": [{\"from\": \"start\", \"to\": \"go_door\"}, {\"from\": \"go_door\", \"to\": \"knock_wait\"}, {\"from\": \"knock_wait\", \"to\": \"branch_teacher\"}, {\"from\": \"branch_teacher\", \"to\": \"photo_confirm\", \"condition\": \"老师在\"}, {\"from\": \"branch_teacher\", \"to\": \"notify_absent\", \"condition\": \"老师不在\"}, {\"from\": \"notify_absent\", \"to\": \"end_absent\"}, {\"from\": \"photo_confirm\", \"to\": \"send_back\"}, {\"from\": \"send_back\", \"to\": \"end_done\"}], \"meta\": {\"status\": \"draft\", \"save_only\": true, \"simulated\": true}}, \"bind_state_path\": \"/_ui/workflow\", \"save_action\": \"workflow.save\", \"save_payload_workflow\": \"$state/_ui/workflow\", \"save_payload_parameters\": {\"workflow_id\": \"wf-c24-lin-teacher-draft\", \"mode\": \"draft\", \"save_only\": true}, \"fallback_text\": [\"1. 走到林老师门口\", \"2. 敲门并等待材料\", \"3. 判断：林老师在吗？\", \"4. 老师不在 → 通知我「林老师不在，已停止等待」→ 结束，不继续等待\", \"5. 老师在 → 拍照确认材料 → 把材料送回 → 结束\"]}}"
